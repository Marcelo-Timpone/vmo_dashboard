# ==============================================================================
# EXED CONSULTING - VMO CORPORATIVO
# VARIÁVEIS DE AMBIENTE (VERCEL / LOCAL / SUPABASE)
# ==============================================================================

# 1. Supabase (Opcional)
# Se preenchidas na Vercel (ou no arquivo .env local), a aplicação sincroniza as 4 tabelas
# diretamente com o banco de dados Supabase (usuarios, configuracao_graficos, links, data_referencia).
# Se NÃO preenchidas (modo padrão ao clonar direto do GitHub), o app funciona 100% no MODO DEMONSTRATIVO / MOCK,
# pronto para apresentação executiva com os 15 projetos corporativos e logos sem precisar de banco de dados.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. Configurações de Deploy e IA (Opcional)
APP_URL=
GEMINI_API_KEY=

# 3. Autenticação de API Corporativa para o Claude (OBRIGATÓRIA)
# Chave de autenticação para o Claude (cabeçalhos x-api-key ou Authorization: Bearer).
#
# OBRIGATÓRIA: não existe mais chave padrão embutida no código. Sem esta
# variável, a API RECUSA toda escrita e todo acesso externo (falha fechada).
# Isso é proposital: a versão anterior trazia a chave de produção escrita no
# repositório, então qualquer pessoa com acesso ao código tinha a credencial.
#
# Gere uma chave longa e aleatória, ex:  openssl rand -hex 32
# Configure na Vercel em Settings > Environment Variables e refaça o deploy.
# Depois, cole a MESMA chave no webapp em Configurações > API do Claude.
# Confira o resultado em /api/vmo/health (campo "pronto_para_o_claude").
EXED_API_KEY=

# 4. Persistência do estado da API do Claude (Obrigatório na Vercel)
# A rota /api/vmo/state (usada pelo Claude para ler/escrever os dados do
# webapp) precisa salvar em algum lugar que sobreviva entre as chamadas.
# Na Vercel, o disco é temporário — então esta chave DEVE ser configurada
# como variável de ambiente no painel do projeto (Settings > Environment
# Variables) para que a integração com o Claude funcione de verdade.
# Pegue em: Supabase > Project Settings > API > service_role (secret).
# NUNCA prefixe com VITE_ e nunca exponha esta chave no navegador — ela dá
# acesso total ao banco, ignorando as políticas de segurança (RLS).
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: só necessário se você não for preencher VITE_SUPABASE_URL acima
# (a URL do projeto não é secreta, então pode ser reaproveitada).
SUPABASE_URL=

# 5. Autenticação Real de Usuários (login + gestão de usuários pelo PMO)
# Segredo usado para assinar as sessões de login (JWT). Gere um valor longo e
# aleatório (ex: openssl rand -hex 32) e configure-o na Vercel também.
# Sem essa variável, um segredo de desenvolvimento inseguro é usado — nunca
# deixe em branco em produção.
AUTH_JWT_SECRET=
